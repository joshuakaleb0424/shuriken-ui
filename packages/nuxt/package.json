{
  "name": "@joshuakaleb/nuxt",
  "type": "module",
  "version": "4.0.0",
  "author": "Css Ninja <hello@cssninja.io> (https://cssninja.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuakaleb0424/shuriken-ui.git",
    "directory": "packages/nuxt"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "style": "./dist/runtime/index.css",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": "./dist/runtime/*",
    "./components/*": "./dist/runtime/components/*",
    "./composables/*": "./dist/runtime/composables/*"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "pnpm build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:types": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@nuxt/icon": "^2.6.2",
    "@nuxt/kit": "^4.6.4",
    "@nuxtjs/color-mode": "^3.5.2",
    "@tailwindcss/vite": "catalog:",
    "@vue/shared": "^3.5.44",
    "@vueuse/core": "catalog:",
    "defu": "^6.1.7",
    "reka-ui": "catalog:",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@nuxt/module-builder": "^1.0.3",
    "eslint": "^10.14.0",
    "nuxt": "catalog:",
    "unbuild": "^3.6.1",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
